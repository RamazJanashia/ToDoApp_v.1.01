<ContentDialog
    x:Class="TodoApp.ProjectEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PanelBrush}">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMinWidth">400</x:Double>
    <x:Double x:Key="ContentDialogMaxWidth">400</x:Double>

    <!-- A bare button: no chrome, so the content, its colour and its focus rectangle are all there is. -->
    <Style x:Key="PlainButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter
                Padding="{TemplateBinding Padding}"
                Background="Transparent"
                Content="{TemplateBinding Content}"
                Foreground="{TemplateBinding Foreground}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 24 px colour swatch: the colour comes from Foreground; a ring shows the choice. -->
    <Style x:Key="SwatchStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualState x:Name="Unchecked" />
                  <VisualState x:Name="Checked">
                    <VisualState.Setters>
                      <Setter Target="Ring.Stroke" Value="{ThemeResource PrimaryTextBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Ellipse Width="18" Height="18" Fill="{TemplateBinding Foreground}" />
              <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="1.5" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 34×30 icon cell: secondary ink; the chosen one is tinted with Foreground on a selection fill. -->
    <Style x:Key="IconChoiceStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="30" />
      <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid x:Name="Cell" Background="Transparent" CornerRadius="7">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualState x:Name="Unchecked">
                    <VisualState.Setters>
                      <Setter Target="Glyph.Foreground" Value="{ThemeResource SecondaryTextBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Checked">
                    <VisualState.Setters>
                      <Setter Target="Cell.Background" Value="{ThemeResource SelectionBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter
                  x:Name="Glyph"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Content="{TemplateBinding Content}"
                  FontFamily="{TemplateBinding FontFamily}"
                  FontSize="{TemplateBinding FontSize}"
                  Foreground="{TemplateBinding Foreground}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </ContentDialog.Resources>

  <StackPanel x:Name="Form" Width="352" PreviewKeyDown="OnPreviewKeyDown">
    <TextBlock x:Name="TitleText" Style="{StaticResource AppTextBase}" FontSize="15" FontWeight="SemiBold" />

    <Grid Margin="0,18,0,0" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="36" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="36" Height="36" CornerRadius="9" Background="{ThemeResource RaisedBrush}">
        <FontIcon x:Name="PreviewGlyph" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBox
          x:Name="NameBox"
          Grid.Column="1"
          VerticalAlignment="Center"
          PlaceholderText="Project name"
          FontSize="16"
          FontWeight="Medium"
          BorderThickness="0"
          Background="Transparent"
          Padding="0,6"
          AutomationProperties.Name="Project name"
          TextChanged="OnNameChanged">
        <TextBox.Resources>
          <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
          <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
          <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        </TextBox.Resources>
      </TextBox>
    </Grid>

    <TextBlock Style="{StaticResource SectionHeaderText}" Text="COLOR" Margin="0,22,0,10" />
    <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="10" />

    <TextBlock Style="{StaticResource SectionHeaderText}" Text="ICON" Margin="0,22,0,10" />
    <Grid x:Name="IconGrid" ColumnSpacing="6" RowSpacing="6" HorizontalAlignment="Left" />

    <Grid Margin="0,26,0,0" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
          x:Name="DeleteButton"
          Style="{StaticResource PlainButtonStyle}"
          Foreground="{ThemeResource RedBrush}"
          FontSize="13"
          Content="Delete Project…"
          Visibility="Collapsed"
          Click="OnDelete" />
      <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Click="OnCancel" />
      <Button x:Name="SaveButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnSave" />
    </Grid>
  </StackPanel>
</ContentDialog>
