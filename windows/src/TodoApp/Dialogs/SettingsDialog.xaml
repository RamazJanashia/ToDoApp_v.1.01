<!-- Settings… (SettingsView.swift): the appearance, what the app shows, and where the data lives. -->
<ContentDialog
    x:Class="TodoApp.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    CloseButtonText="Close"
    DefaultButton="Close"
    Background="{ThemeResource PanelBrush}">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
    <x:Double x:Key="ContentDialogMaxWidth">480</x:Double>
  </ContentDialog.Resources>

  <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <StackPanel Spacing="24" Padding="0,0,12,0">
      <StackPanel Spacing="8">
        <TextBlock Style="{StaticResource BodyText}" Foreground="{ThemeResource PrimaryTextBrush}" Text="Appearance" />
        <SelectorBar x:Name="AppearanceBar">
          <SelectorBarItem Text="System" />
          <SelectorBarItem Text="Light" />
          <SelectorBarItem Text="Dark" />
        </SelectorBar>
        <TextBlock
            Style="{StaticResource SmallText}"
            Foreground="{ThemeResource SecondaryTextBrush}"
            TextWrapping="Wrap"
            Text="System follows the light or dark setting in Windows." />
      </StackPanel>

      <!-- One heading and two columns of switches per group (BuildGroups). -->
      <StackPanel x:Name="Groups" Spacing="24" />

      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Style="{StaticResource SmallText}"
            Foreground="{ThemeResource SecondaryTextBrush}"
            TextWrapping="Wrap"
            VerticalAlignment="Center"
            Text="Hiding something removes it from view. Your tasks aren’t changed." />
        <Button x:Name="ShowEverythingButton" Grid.Column="1" Content="Show Everything" />
      </Grid>

      <Rectangle Height="1" Fill="{ThemeResource SeparatorBrush}" />

      <StackPanel Spacing="8">
        <TextBlock Style="{StaticResource BodyText}" Foreground="{ThemeResource PrimaryTextBrush}" FontWeight="SemiBold" Text="Data" />
        <TextBlock
            Style="{StaticResource SmallText}"
            Foreground="{ThemeResource SecondaryTextBrush}"
            TextWrapping="Wrap"
            Text="Tasks, daily backups and attachments all live in one folder. Copy it to back up everything." />
        <TextBlock
            x:Name="DataPath"
            FontFamily="Cascadia Mono, Consolas"
            FontSize="11"
            Foreground="{ThemeResource PrimaryTextBrush}"
            IsTextSelectionEnabled="True"
            TextWrapping="Wrap" />
        <Button x:Name="ShowDataFolderButton" Content="Show Data Folder" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
