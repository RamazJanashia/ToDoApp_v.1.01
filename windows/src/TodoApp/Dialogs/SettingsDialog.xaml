<!-- Settings… (SettingsView.swift): the appearance, three ways. -->
<ContentDialog
    x:Class="TodoApp.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    CloseButtonText="Close"
    DefaultButton="Close"
    Background="{ThemeResource PanelBrush}">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMinWidth">380</x:Double>
    <x:Double x:Key="ContentDialogMaxWidth">380</x:Double>
  </ContentDialog.Resources>

  <StackPanel Spacing="10">
    <TextBlock Style="{StaticResource BodyText}" Foreground="{ThemeResource PrimaryTextBrush}" Text="Appearance" />
    <SelectorBar x:Name="AppearanceBar">
      <SelectorBarItem Text="System" />
      <SelectorBarItem Text="Light" />
      <SelectorBarItem Text="Dark" />
    </SelectorBar>
    <TextBlock
        Style="{StaticResource SmallText}"
        Foreground="{ThemeResource SecondaryTextBrush}"
        TextWrapping="Wrap"
        Text="System follows the light or dark setting in Windows." />
  </StackPanel>
</ContentDialog>
