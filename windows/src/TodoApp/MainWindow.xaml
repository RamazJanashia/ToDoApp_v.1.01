<Window
    x:Class="TodoApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TodoApp">
  <Grid x:Name="Root" Background="{ThemeResource BackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar: the window title centred; search, appearance and inspector on the right (placeholders for now). -->
    <Grid x:Name="TitleBarArea" Background="Transparent">
      <TextBlock
          x:Name="TitleText"
          Style="{StaticResource AppTextBase}"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontSize="13"
          FontWeight="Medium"
          Opacity="0.88"
          MaxLines="1"
          TextTrimming="CharacterEllipsis" />
      <StackPanel
          x:Name="TitleBarTrailing"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="8">
        <Border
            x:Name="SearchBorder"
            Width="210"
            Height="28"
            Padding="9,0,4,0"
            CornerRadius="7"
            Background="{ThemeResource PanelBrush}"
            BorderBrush="{ThemeResource SeparatorBrush}"
            BorderThickness="1">
          <Border.Resources>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
          </Border.Resources>
          <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="SearchGlyph" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource TertiaryTextBrush}" VerticalAlignment="Center" />
            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                PlaceholderText="Search"
                PlaceholderForeground="{ThemeResource TertiaryTextBrush}"
                Foreground="{ThemeResource PrimaryTextBrush}"
                FontSize="13"
                BorderThickness="0"
                Background="Transparent"
                Padding="0"
                MinHeight="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Search tasks" />
            <Button
                x:Name="SearchClear"
                Grid.Column="2"
                Style="{StaticResource IconButtonStyle}"
                Width="20"
                Height="20"
                FontSize="9"
                Visibility="Collapsed"
                ToolTipService.ToolTip="Clear Search"
                AutomationProperties.Name="Clear search" />
          </Grid>
        </Border>
        <Button x:Name="AppearanceButton" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Appearance" AutomationProperties.Name="Appearance" />
        <Button x:Name="InspectorButton" Style="{StaticResource IconButtonStyle}" FontSize="15" AutomationProperties.Name="Toggle inspector" />
        <Button x:Name="MoreButton" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="More" AutomationProperties.Name="More" />
      </StackPanel>
    </Grid>

    <!-- Sidebar · centre · inspector. The edge columns are 1 px; their resizers reach into the neighbours. -->
    <Grid x:Name="Columns" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="250" />
        <ColumnDefinition x:Name="SidebarEdgeColumn" Width="1" />
        <ColumnDefinition Width="*" MinWidth="500" />
        <ColumnDefinition x:Name="InspectorEdgeColumn" Width="1" />
        <ColumnDefinition x:Name="InspectorColumn" Width="340" />
      </Grid.ColumnDefinitions>
      <ContentControl
          x:Name="SidebarHost"
          Grid.Column="0"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch"
          IsTabStop="False" />
      <ContentControl
          x:Name="CenterHost"
          Grid.Column="2"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch"
          IsTabStop="False" />
      <ContentControl
          x:Name="InspectorHost"
          Grid.Column="4"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch"
          IsTabStop="False" />
      <local:ColumnResizer x:Name="SidebarResizer" Grid.Column="1" Direction="1" />
      <local:ColumnResizer
          x:Name="InspectorResizer"
          Grid.Column="3"
          Direction="-1"
          VerticalInset="14"
          LineBrush="{ThemeResource SeparatorBrush}" />
    </Grid>

    <!-- The hairline under the title bar. -->
    <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Top" Fill="{ThemeResource SeparatorBrush}" />
  </Grid>
</Window>
