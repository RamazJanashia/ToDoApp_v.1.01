<!--
  Text styles from Theme.Font (Mac point sizes map 1:1 to effective pixels) and the borderless
  icon button from Components.swift. Text is Segoe UI Variable, the system UI font.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="AppTextBase" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
  </Style>

  <Style x:Key="PageTitleText" TargetType="TextBlock" BasedOn="{StaticResource AppTextBase}">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource AppTextBase}">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style x:Key="RowTitleText" TargetType="TextBlock" BasedOn="{StaticResource AppTextBase}">
    <Setter Property="FontSize" Value="14.5" />
  </Style>

  <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource AppTextBase}">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="SmallText" TargetType="TextBlock" BasedOn="{StaticResource AppTextBase}">
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- "WORKSPACE", "NOTES": the view upper-cases the text. Tracking 0.9 pt is 80/1000 em at 11.5. -->
  <Style x:Key="SectionHeaderText" TargetType="TextBlock" BasedOn="{StaticResource AppTextBase}">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CharacterSpacing" Value="80" />
    <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <!-- A 28×28 glyph button with no border: secondary ink, a hover fill and primary ink on hover. -->
  <Style x:Key="IconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource HoverBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PrimaryTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource SelectionBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PrimaryTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter
                x:Name="ContentPresenter"
                Padding="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                ContentTransitions="{TemplateBinding ContentTransitions}"
                FontFamily="{TemplateBinding FontFamily}"
                FontSize="{TemplateBinding FontSize}"
                Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
