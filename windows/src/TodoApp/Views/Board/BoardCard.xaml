<!-- One card on the board (KanbanCard in KanbanBoardView.swift). -->
<UserControl
    x:Class="TodoApp.BoardCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TodoApp"
    IsTabStop="False">
  <Grid x:Name="Root" Background="Transparent" CanDrag="True" AllowDrop="True">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="CardStates">
        <VisualState x:Name="CardNormal" />
        <VisualState x:Name="CardHover">
          <VisualState.Setters>
            <Setter Target="Chrome.Background" Value="{ThemeResource RaisedHoverBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="CardSelected">
          <VisualState.Setters>
            <Setter Target="Chrome.Background" Value="{ThemeResource RaisedSelectedBrush}" />
            <Setter Target="Chrome.BorderBrush" Value="{ThemeResource SelectedOutlineBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="TitleStates">
        <VisualState x:Name="TitleNormal" />
        <!-- Done or untitled. -->
        <VisualState x:Name="TitleDimmed">
          <VisualState.Setters>
            <Setter Target="TitleText.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border
        x:Name="Chrome"
        CornerRadius="10"
        Padding="12"
        BorderThickness="1"
        BorderBrush="{ThemeResource SeparatorBrush}"
        Background="{ThemeResource RaisedBrush}">
      <StackPanel Spacing="9">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <local:CheckCircle
              x:Name="Check"
              Size="16"
              Margin="0,1,0,0"
              VerticalAlignment="Top"
              OpenBrush="{ThemeResource CheckboxFillBrush}"
              OpenHoverBrush="{ThemeResource CheckboxHoverBrush}"
              DoneBrush="{ThemeResource GreenBrush}"
              TickBrush="{ThemeResource BackgroundBrush}" />
          <TextBlock
              x:Name="TitleText"
              Grid.Column="1"
              Style="{StaticResource AppTextBase}"
              FontSize="13.5"
              Foreground="{ThemeResource PrimaryTextBrush}"
              TextWrapping="Wrap"
              MaxLines="3"
              TextTrimming="CharacterEllipsis" />
          <!-- The flag, or the ⓘ while the pointer is over the card. -->
          <Grid Grid.Column="2" Width="20" Height="18" VerticalAlignment="Top">
            <local:PriorityFlag
                x:Name="Flag"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RedBrush="{ThemeResource RedBrush}"
                PriorityMediumBrush="{ThemeResource PriorityMediumBrush}"
                PriorityLowBrush="{ThemeResource PriorityLowBrush}"
                TertiaryBrush="{ThemeResource TertiaryTextBrush}" />
            <Button
                x:Name="DetailsButton"
                Style="{StaticResource IconButtonStyle}"
                Width="20"
                Height="18"
                FontSize="12"
                IsTabStop="False"
                Visibility="Collapsed"
                ToolTipService.ToolTip="Show Details (double-click)"
                AutomationProperties.Name="Show details" />
          </Grid>
        </Grid>
        <local:MetaLine
            x:Name="Meta"
            Margin="26,0,0,0"
            TextBrush="{ThemeResource SecondaryTextBrush}"
            OverdueBrush="{ThemeResource RedBrush}" />
      </StackPanel>
    </Border>

    <!-- Dropping here puts the dragged card in front of this one. -->
    <Border
        x:Name="DropLine"
        Height="2"
        Margin="0,-5,0,0"
        VerticalAlignment="Top"
        CornerRadius="1"
        Background="{ThemeResource BlueBrush}"
        Opacity="0"
        IsHitTestVisible="False" />
  </Grid>
</UserControl>
