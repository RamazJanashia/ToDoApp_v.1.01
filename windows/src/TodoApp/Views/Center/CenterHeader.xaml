<UserControl
    x:Class="TodoApp.CenterHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TodoApp"
    IsTabStop="False">
  <Grid x:Name="Root" Padding="32,26,32,10">
    <VisualStateManager.VisualStateGroups>
      <!-- The current view's button sits on the selection fill in primary ink. -->
      <VisualStateGroup x:Name="ViewModeStates">
        <VisualState x:Name="ListMode">
          <VisualState.Setters>
            <Setter Target="ListButton.Background" Value="{ThemeResource SelectionBrush}" />
            <Setter Target="ListButton.Foreground" Value="{ThemeResource PrimaryTextBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="BoardMode">
          <VisualState.Setters>
            <Setter Target="BoardButton.Background" Value="{ThemeResource SelectionBrush}" />
            <Setter Target="BoardButton.Foreground" Value="{ThemeResource PrimaryTextBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="CalendarMode">
          <VisualState.Setters>
            <Setter Target="CalendarButton.Background" Value="{ThemeResource SelectionBrush}" />
            <Setter Target="CalendarButton.Foreground" Value="{ThemeResource PrimaryTextBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <!-- Both filter symbols share one glyph, so filtering shows as a fill and primary ink instead. -->
      <VisualStateGroup x:Name="FilterStates">
        <VisualState x:Name="NotFiltering" />
        <VisualState x:Name="Filtering">
          <VisualState.Setters>
            <Setter Target="FilterButton.Background" Value="{ThemeResource SelectionBrush}" />
            <Setter Target="FilterButton.Foreground" Value="{ThemeResource PrimaryTextBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- Lines up with the list below: capped at the reading width and centred in list mode. -->
    <StackPanel x:Name="Body">
      <Grid ColumnSpacing="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 4 + a 16 minimum spacer + 4 to the switcher. -->
        <TextBlock
            x:Name="TitleText"
            Style="{StaticResource PageTitleText}"
            Margin="0,0,20,0"
            VerticalAlignment="Center"
            MaxLines="1"
            TextTrimming="CharacterEllipsis" />

        <Border Grid.Column="1" Margin="0,0,6,0" Padding="2" CornerRadius="9" VerticalAlignment="Center" Background="{ThemeResource PanelBrush}">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button
                x:Name="ListButton"
                Style="{StaticResource IconButtonStyle}"
                FontSize="13"
                ToolTipService.ToolTip="List (Ctrl+1)"
                AutomationProperties.Name="List"
                Click="OnList" />
            <Button
                x:Name="BoardButton"
                Style="{StaticResource IconButtonStyle}"
                FontSize="13"
                ToolTipService.ToolTip="Board (Ctrl+2)"
                AutomationProperties.Name="Board"
                Click="OnBoard" />
            <Button
                x:Name="CalendarButton"
                Style="{StaticResource IconButtonStyle}"
                FontSize="13"
                ToolTipService.ToolTip="Calendar (Ctrl+3)"
                AutomationProperties.Name="Calendar"
                Click="OnCalendar" />
          </StackPanel>
        </Border>

        <Button
            x:Name="FilterButton"
            Grid.Column="2"
            Style="{StaticResource IconButtonStyle}"
            VerticalAlignment="Center"
            ToolTipService.ToolTip="Sort and Filter"
            AutomationProperties.Name="Sort and Filter">
          <Button.Flyout>
            <MenuFlyout x:Name="FilterMenu" Placement="BottomEdgeAlignedLeft" Opening="OnFilterMenuOpening" />
          </Button.Flyout>
        </Button>

        <Button
            x:Name="NewTaskButton"
            Grid.Column="3"
            Style="{StaticResource IconButtonStyle}"
            FontSize="17"
            VerticalAlignment="Center"
            ToolTipService.ToolTip="New Task (Ctrl+N)"
            AutomationProperties.Name="New Task"
            Click="OnNewTask" />
      </Grid>

      <TextBlock
          x:Name="SubtitleText"
          Style="{StaticResource BodyText}"
          Foreground="{ThemeResource SecondaryTextBrush}"
          Margin="0,10,0,0"
          MaxLines="1"
          TextTrimming="CharacterEllipsis" />

      <local:ProgressLine
          x:Name="Progress"
          Margin="0,16,0,0"
          TrackBrush="{ThemeResource TrackBrush}"
          FillBrush="{ThemeResource GreenBrush}" />
    </StackPanel>
  </Grid>
</UserControl>
