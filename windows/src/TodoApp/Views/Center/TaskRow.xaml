<UserControl
    x:Class="TodoApp.TaskRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TodoApp"
    IsTabStop="False">
  <Grid x:Name="Chrome" Background="Transparent" CanDrag="True" AllowDrop="True">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="TitleStates">
        <VisualState x:Name="TitleNormal" />
        <!-- Done or untitled. -->
        <VisualState x:Name="TitleDimmed">
          <VisualState.Setters>
            <Setter Target="TitleText.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- The hover and selection fills reach 12 px past the row on each side and stop 2 px short of its top and bottom. -->
    <Border x:Name="HoverFill" Margin="-12,2" CornerRadius="8" Background="{ThemeResource HoverBrush}" Opacity="0" IsHitTestVisible="False" />
    <Border x:Name="SelectionFill" Margin="-12,2" CornerRadius="8" Background="{ThemeResource SelectionBrush}" Opacity="0" IsHitTestVisible="False" />

    <Grid Padding="0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Top-aligned: a long title wraps rather than being cut, and the circle stays by its first line. -->
      <local:CheckCircle
          x:Name="Check"
          VerticalAlignment="Top"
          OpenBrush="{ThemeResource CheckboxFillBrush}"
          OpenHoverBrush="{ThemeResource CheckboxHoverBrush}"
          DoneBrush="{ThemeResource GreenBrush}"
          TickBrush="{ThemeResource BackgroundBrush}" />

      <!-- 14 to the circle; 14 + a 12 minimum spacer + 14 to the details button. -->
      <StackPanel Grid.Column="1" Margin="14,0,26,0" VerticalAlignment="Top">
        <TextBlock x:Name="TitleText" Style="{StaticResource RowTitleText}" TextWrapping="Wrap" />
        <local:MetaLine
            x:Name="Meta"
            Margin="0,4,0,0"
            TextBrush="{ThemeResource SecondaryTextBrush}"
            OverdueBrush="{ThemeResource RedBrush}" />
        <!-- How far the subtasks have come; only for a task with subtasks. -->
        <local:ProgressLine
            x:Name="SubtaskProgress"
            Width="220"
            HorizontalAlignment="Left"
            Margin="0,7,0,0"
            Visibility="Collapsed"
            TrackBrush="{ThemeResource TrackBrush}"
            FillBrush="{ThemeResource GreenBrush}" />
      </StackPanel>

      <Button
          x:Name="DetailsButton"
          Grid.Column="2"
          Style="{StaticResource IconButtonStyle}"
          VerticalAlignment="Top"
          Margin="0,-4,0,0"
          IsTabStop="False"
          Opacity="0"
          IsHitTestVisible="False"
          ToolTipService.ToolTip="Show Details (double-click)"
          AutomationProperties.Name="Show details" />

      <local:PriorityFlag
          x:Name="Flag"
          Grid.Column="3"
          Margin="14,2,0,0"
          VerticalAlignment="Top"
          RedBrush="{ThemeResource RedBrush}"
          PriorityMediumBrush="{ThemeResource PriorityMediumBrush}"
          PriorityLowBrush="{ThemeResource PriorityLowBrush}"
          TertiaryBrush="{ThemeResource TertiaryTextBrush}" />
    </Grid>

    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource SeparatorBrush}" IsHitTestVisible="False" />

    <!-- Dropping here puts the dragged task in front of this one. -->
    <Border
        x:Name="DropLine"
        Height="2"
        Margin="0,-1,0,0"
        VerticalAlignment="Top"
        CornerRadius="1"
        Background="{ThemeResource BlueBrush}"
        Opacity="0"
        IsHitTestVisible="False" />
  </Grid>
</UserControl>
