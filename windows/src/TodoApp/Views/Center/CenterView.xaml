<UserControl
    x:Class="TodoApp.CenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TodoApp"
    IsTabStop="False">
  <Grid Background="{ThemeResource BackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <local:CenterHeader x:Name="Header" />
    <local:TaskListView x:Name="TaskList" Grid.Row="1" />

    <local:BoardView x:Name="Board" Grid.Row="1" Visibility="Collapsed" />

    <local:CalendarMonthView x:Name="MonthView" Grid.Row="1" Visibility="Collapsed" />

    <!-- A placeholder until the dashboard exists (Task 19). -->
    <!-- The dashboard replaces the header as well. -->
    <Grid x:Name="DashboardHost" Grid.RowSpan="2" Visibility="Collapsed" />
  </Grid>
</UserControl>
