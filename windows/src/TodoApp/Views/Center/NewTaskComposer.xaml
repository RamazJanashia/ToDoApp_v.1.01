<UserControl
    x:Class="TodoApp.NewTaskComposer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
  <UserControl.Resources>
    <!-- "+ New task": secondary ink, primary under the pointer, no chrome. -->
    <Style x:Key="OpenerStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
      <Setter Property="Padding" Value="0,18" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter
                x:Name="Presenter"
                Padding="{TemplateBinding Padding}"
                Background="Transparent"
                Content="{TemplateBinding Content}"
                Foreground="{TemplateBinding Foreground}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Presenter.Foreground" Value="{ThemeResource PrimaryTextBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Presenter.Foreground" Value="{ThemeResource PrimaryTextBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </ContentPresenter>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Button
        x:Name="Opener"
        Style="{StaticResource OpenerStyle}"
        IsTabStop="False"
        AutomationProperties.Name="New task"
        Click="OnOpen">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon x:Name="PlusGlyph" Width="20" FontSize="14" />
        <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" FontSize="14" Text="New task" />
      </StackPanel>
    </Button>

    <!-- Open: an outline circle, the field and the hint, over a hairline. -->
    <Grid x:Name="Editor" Visibility="Collapsed">
      <Grid Margin="0,15" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="20" Height="20" Stroke="{ThemeResource TertiaryTextBrush}" StrokeThickness="1.2" VerticalAlignment="Center" />
        <TextBox
            x:Name="Input"
            Grid.Column="1"
            VerticalAlignment="Center"
            PlaceholderText="New task"
            PlaceholderForeground="{ThemeResource TertiaryTextBrush}"
            FontSize="14.5"
            BorderThickness="0"
            Background="Transparent"
            Padding="0"
            MinHeight="0"
            AutomationProperties.Name="New task"
            PreviewKeyDown="OnInputKeyDown"
            LostFocus="OnInputLostFocus">
          <TextBox.Resources>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
          </TextBox.Resources>
        </TextBox>
        <TextBlock
            Grid.Column="2"
            Style="{StaticResource SmallText}"
            Foreground="{ThemeResource TertiaryTextBrush}"
            VerticalAlignment="Center"
            Text="Enter to add · Esc to close" />
      </Grid>
      <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource SeparatorBrush}" />
    </Grid>
  </Grid>
</UserControl>
