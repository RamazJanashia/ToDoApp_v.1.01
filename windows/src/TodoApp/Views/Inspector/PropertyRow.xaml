<!-- Icon + value; clicking opens a flyout to the left to change it (PropertyRow in InspectorView.swift). -->
<UserControl
    x:Class="TodoApp.PropertyRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
  <UserControl.Resources>
    <!-- 38 high, 8 px side padding, a hover fill with 7 px corners and no other chrome. -->
    <Style x:Key="RowButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="RootGrid.Background" Value="{ThemeResource HoverBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="RootGrid.Background" Value="{ThemeResource HoverBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter
                  Padding="{TemplateBinding Padding}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                  Content="{TemplateBinding Content}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The flyout's own chrome is see-through: Surface draws the panel, so it can follow the window's theme. -->
    <Style x:Key="SurfacePresenterStyle" TargetType="FlyoutPresenter">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
  </UserControl.Resources>

  <Grid x:Name="Chrome">
    <VisualStateManager.VisualStateGroups>
      <!-- While the flyout is open the row keeps the selection fill. -->
      <VisualStateGroup x:Name="OpenStates">
        <VisualState x:Name="Closed" />
        <VisualState x:Name="Open">
          <VisualState.Setters>
            <Setter Target="OpenFill.Opacity" Value="1" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="TextStates">
        <VisualState x:Name="Value" />
        <VisualState x:Name="Placeholder">
          <VisualState.Setters>
            <Setter Target="ValueText.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <!-- The icon tokens of PropertyRowModel; a project's own colour is drawn by TintGlyph. -->
      <VisualStateGroup x:Name="TintStates">
        <VisualState x:Name="TintSecondary" />
        <VisualState x:Name="TintTertiary">
          <VisualState.Setters>
            <Setter Target="IconGlyph.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="TintRed">
          <VisualState.Setters>
            <Setter Target="IconGlyph.Foreground" Value="{ThemeResource RedBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="TintGreen">
          <VisualState.Setters>
            <Setter Target="IconGlyph.Foreground" Value="{ThemeResource GreenBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="TintPriorityMedium">
          <VisualState.Setters>
            <Setter Target="IconGlyph.Foreground" Value="{ThemeResource PriorityMediumBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="TintPriorityLow">
          <VisualState.Setters>
            <Setter Target="IconGlyph.Foreground" Value="{ThemeResource PriorityLowBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="TintProject">
          <VisualState.Setters>
            <Setter Target="IconGlyph.Visibility" Value="Collapsed" />
            <Setter Target="TintGlyph.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border x:Name="OpenFill" CornerRadius="7" Background="{ThemeResource SelectionBrush}" Opacity="0" IsHitTestVisible="False" />

    <Button x:Name="RowButton" Style="{StaticResource RowButtonStyle}">
      <Button.Flyout>
        <Flyout x:Name="Popover" Placement="Left" FlyoutPresenterStyle="{StaticResource SurfacePresenterStyle}">
          <Border x:Name="Surface" CornerRadius="8" Background="{ThemeResource PanelBrush}" />
        </Flyout>
      </Button.Flyout>

      <Grid ColumnSpacing="13">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon
            x:Name="IconGlyph"
            FontSize="14"
            Foreground="{ThemeResource SecondaryTextBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
        <FontIcon
            x:Name="TintGlyph"
            FontSize="14"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
        <TextBlock
            x:Name="ValueText"
            Grid.Column="1"
            Style="{StaticResource BodyText}"
            VerticalAlignment="Center"
            MaxLines="1"
            TextTrimming="CharacterEllipsis" />
      </Grid>
    </Button>
  </Grid>
</UserControl>
