<!-- The right-hand "Task details" panel (InspectorView.swift). Every edit applies and saves immediately. -->
<UserControl
    x:Class="TodoApp.InspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TodoApp"
    IsTabStop="False">
  <Grid Background="{ThemeResource BackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Padding="22,22,14,10">
      <TextBlock Style="{StaticResource BodyText}" FontWeight="Medium" VerticalAlignment="Center" Text="Task details" />
      <Button
          x:Name="CloseButton"
          Style="{StaticResource IconButtonStyle}"
          FontSize="13"
          HorizontalAlignment="Right"
          ToolTipService.ToolTip="Close Inspector (Ctrl+Shift+I)"
          AutomationProperties.Name="Close Inspector" />
    </Grid>

    <!-- Nothing selected: the message sits a third of the way down. -->
    <Grid x:Name="EmptyPanel" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="2*" />
      </Grid.RowDefinitions>
      <local:EmptyState x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center" />
    </Grid>

    <ScrollViewer
        x:Name="Form"
        Grid.Row="1"
        Visibility="Collapsed"
        VerticalScrollBarVisibility="Hidden"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
      <StackPanel Padding="22,0,18,24">
        <!-- The circle lines up with the first line of the title. -->
        <Grid Margin="0,10,0,22" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <local:CheckCircle
              x:Name="Check"
              Size="17"
              Margin="0,4,0,0"
              VerticalAlignment="Top"
              OpenBrush="{ThemeResource CheckboxFillBrush}"
              OpenHoverBrush="{ThemeResource CheckboxHoverBrush}"
              DoneBrush="{ThemeResource GreenBrush}"
              TickBrush="{ThemeResource BackgroundBrush}" />
          <!-- Wraps, up to five 23 px lines. A done task's title is dimmed to about the secondary ink. -->
          <TextBox
              x:Name="TitleBox"
              Grid.Column="1"
              PlaceholderText="Task name"
              PlaceholderForeground="{ThemeResource TertiaryTextBrush}"
              Foreground="{ThemeResource PrimaryTextBrush}"
              FontSize="17"
              FontWeight="SemiBold"
              TextWrapping="Wrap"
              AcceptsReturn="False"
              MaxHeight="115"
              BorderThickness="0"
              Background="Transparent"
              Padding="0"
              MinHeight="0"
              AutomationProperties.Name="Task name">
            <TextBox.Resources>
              <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
              <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
              <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            </TextBox.Resources>
          </TextBox>
        </Grid>

        <StackPanel Margin="-8,0" Spacing="2">
          <local:PropertyRow x:Name="DueRow">
            <local:PropertyRow.FlyoutContent>
              <local:DueDateFlyout x:Name="DueFlyout" />
            </local:PropertyRow.FlyoutContent>
          </local:PropertyRow>

          <local:PropertyRow x:Name="ReminderRow">
            <local:PropertyRow.FlyoutContent>
              <local:ReminderFlyout
                  x:Name="ReminderOptions"
                  Width="230"
                  PrimaryBrush="{ThemeResource PrimaryTextBrush}"
                  SecondaryBrush="{ThemeResource SecondaryTextBrush}"
                  TertiaryBrush="{ThemeResource TertiaryTextBrush}"
                  HoverBrush="{ThemeResource SelectionBrush}"
                  SeparatorBrush="{ThemeResource SeparatorBrush}" />
            </local:PropertyRow.FlyoutContent>
          </local:PropertyRow>

          <local:PropertyRow x:Name="PriorityRow">
            <local:PropertyRow.FlyoutContent>
              <local:OptionList
                  x:Name="PriorityOptions"
                  Width="200"
                  PrimaryBrush="{ThemeResource PrimaryTextBrush}"
                  SecondaryBrush="{ThemeResource SecondaryTextBrush}"
                  TertiaryBrush="{ThemeResource TertiaryTextBrush}"
                  HoverBrush="{ThemeResource SelectionBrush}"
                  SeparatorBrush="{ThemeResource SeparatorBrush}"
                  RedBrush="{ThemeResource RedBrush}"
                  PriorityMediumBrush="{ThemeResource PriorityMediumBrush}"
                  PriorityLowBrush="{ThemeResource PriorityLowBrush}" />
            </local:PropertyRow.FlyoutContent>
          </local:PropertyRow>

          <local:PropertyRow x:Name="ProjectRow">
            <local:PropertyRow.FlyoutContent>
              <local:OptionList
                  x:Name="ProjectOptions"
                  Width="220"
                  PrimaryBrush="{ThemeResource PrimaryTextBrush}"
                  SecondaryBrush="{ThemeResource SecondaryTextBrush}"
                  TertiaryBrush="{ThemeResource TertiaryTextBrush}"
                  HoverBrush="{ThemeResource SelectionBrush}"
                  SeparatorBrush="{ThemeResource SeparatorBrush}" />
            </local:PropertyRow.FlyoutContent>
          </local:PropertyRow>

          <local:PropertyRow x:Name="RepeatRow">
            <local:PropertyRow.FlyoutContent>
              <local:RepeatFlyout x:Name="RepeatEditor" />
            </local:PropertyRow.FlyoutContent>
          </local:PropertyRow>

          <local:PropertyRow x:Name="StatusRow">
            <local:PropertyRow.FlyoutContent>
              <local:OptionList
                  x:Name="StatusOptions"
                  Width="200"
                  PrimaryBrush="{ThemeResource PrimaryTextBrush}"
                  SecondaryBrush="{ThemeResource SecondaryTextBrush}"
                  TertiaryBrush="{ThemeResource TertiaryTextBrush}"
                  HoverBrush="{ThemeResource SelectionBrush}"
                  SeparatorBrush="{ThemeResource SeparatorBrush}" />
            </local:PropertyRow.FlyoutContent>
          </local:PropertyRow>
        </StackPanel>

        <TextBlock Style="{StaticResource SectionHeaderText}" Margin="0,30,0,10" Text="NOTES" />
        <!-- Primary ink at 0.85, at least two lines. -->
        <TextBox
            x:Name="NotesBox"
            PlaceholderText="Add notes"
            PlaceholderForeground="{ThemeResource TertiaryTextBrush}"
            Foreground="{ThemeResource PrimaryTextBrush}"
            Opacity="0.85"
            FontSize="14"
            TextWrapping="Wrap"
            AcceptsReturn="True"
            MinHeight="38"
            BorderThickness="0"
            Background="Transparent"
            Padding="0"
            AutomationProperties.Name="Notes">
          <TextBox.Resources>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
          </TextBox.Resources>
        </TextBox>

        <local:SubtasksSection x:Name="Subtasks" />
        <local:AttachmentsSection x:Name="AttachmentList" />

        <Rectangle Height="1" Margin="0,30,0,0" Fill="{ThemeResource SeparatorBrush}" />
        <Grid Margin="0,10,0,0" ColumnSpacing="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
              x:Name="CreatedText"
              Style="{StaticResource SmallText}"
              Foreground="{ThemeResource TertiaryTextBrush}"
              VerticalAlignment="Center"
              MaxLines="1"
              TextTrimming="CharacterEllipsis" />
          <Button
              x:Name="DuplicateButton"
              Grid.Column="1"
              Style="{StaticResource IconButtonStyle}"
              FontSize="13"
              ToolTipService.ToolTip="Duplicate (Ctrl+D)"
              AutomationProperties.Name="Duplicate" />
          <Button
              x:Name="DeleteButton"
              Grid.Column="2"
              Style="{StaticResource IconButtonStyle}"
              FontSize="13"
              ToolTipService.ToolTip="Delete (Delete)"
              AutomationProperties.Name="Delete" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
