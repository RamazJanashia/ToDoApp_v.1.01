<!-- One subtask (SubtaskRow in SubtasksAndAttachments.swift): a square check, an editable title and a hover ×. -->
<UserControl
    x:Class="TodoApp.SubtaskRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
  <UserControl.Resources>
    <!-- The title looks like plain text: no box, no fill, no focus underline. -->
    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
  </UserControl.Resources>

  <!-- Grows with a title that wraps; the check and the delete button stay by its first line. -->
  <Grid x:Name="Root" MinHeight="34" Padding="0,8" ColumnSpacing="12" Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="20" />
    </Grid.ColumnDefinitions>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="CheckStates">
        <VisualState x:Name="CheckOpen">
          <VisualState.Setters>
            <Setter Target="CheckIcon.Foreground" Value="{ThemeResource SecondaryTextBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="CheckHover">
          <VisualState.Setters>
            <Setter Target="CheckIcon.Foreground" Value="{ThemeResource PrimaryTextBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="CheckDone">
          <VisualState.Setters>
            <Setter Target="CheckIcon.Foreground" Value="{ThemeResource GreenBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="TitleStates">
        <VisualState x:Name="TitleOpen">
          <VisualState.Setters>
            <Setter Target="TitleBox.Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            <Setter Target="Strike.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <!-- A text box can't strike through its text, so a done title is drawn by the text block under the clear text. -->
        <VisualState x:Name="TitleDone">
          <VisualState.Setters>
            <Setter Target="TitleBox.Foreground" Value="Transparent" />
            <Setter Target="Strike.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border x:Name="CheckHit" Background="Transparent" Width="20" Height="20" VerticalAlignment="Top">
      <FontIcon x:Name="CheckIcon" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <Grid Grid.Column="1" VerticalAlignment="Top">
      <TextBlock
          x:Name="Strike"
          Style="{StaticResource BodyText}"
          Foreground="{ThemeResource TertiaryTextBrush}"
          TextDecorations="Strikethrough"
          TextWrapping="Wrap"
          IsHitTestVisible="False"
          VerticalAlignment="Top"
          Margin="0"
          Visibility="Collapsed" />
      <TextBox
          x:Name="TitleBox"
          PlaceholderText="Subtask"
          PlaceholderForeground="{ThemeResource TertiaryTextBrush}"
          Foreground="{ThemeResource PrimaryTextBrush}"
          FontSize="14"
          AcceptsReturn="False"
          TextWrapping="Wrap"
          BorderThickness="0"
          Background="Transparent"
          Padding="0"
          MinHeight="0"
          VerticalAlignment="Top"
          AutomationProperties.Name="Subtask" />
    </Grid>

    <Button
        x:Name="RemoveButton"
        Grid.Column="2"
        Style="{StaticResource IconButtonStyle}"
        Width="20"
        Height="20"
        FontSize="10"
        Opacity="0"
        VerticalAlignment="Top"
        ToolTipService.ToolTip="Delete Subtask"
        AutomationProperties.Name="Delete Subtask" />
  </Grid>
</UserControl>
