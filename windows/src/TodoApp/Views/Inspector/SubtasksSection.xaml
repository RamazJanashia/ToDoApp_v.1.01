<!-- The "Subtasks" part of the task details (SubtasksSection in SubtasksAndAttachments.swift). -->
<UserControl
    x:Class="TodoApp.SubtasksSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
  <UserControl.Resources>
    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
  </UserControl.Resources>

  <StackPanel>
    <Grid Margin="0,30,0,8">
      <TextBlock Style="{StaticResource SectionHeaderText}" Text="SUBTASKS" />
      <TextBlock
          x:Name="Progress"
          Style="{StaticResource SmallText}"
          Foreground="{ThemeResource TertiaryTextBrush}"
          Typography.NumeralAlignment="Tabular"
          HorizontalAlignment="Right"
          Visibility="Collapsed" />
    </Grid>

    <StackPanel x:Name="Rows" />

    <Grid Height="34" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <FontIcon
          x:Name="PlusIcon"
          FontSize="12"
          Foreground="{ThemeResource TertiaryTextBrush}"
          HorizontalAlignment="Center"
          VerticalAlignment="Center" />
      <TextBox
          x:Name="AddBox"
          Grid.Column="1"
          PlaceholderText="Add subtask"
          PlaceholderForeground="{ThemeResource TertiaryTextBrush}"
          Foreground="{ThemeResource PrimaryTextBrush}"
          FontSize="14"
          AcceptsReturn="False"
          TextWrapping="NoWrap"
          BorderThickness="0"
          Background="Transparent"
          Padding="0"
          MinHeight="0"
          VerticalAlignment="Center"
          AutomationProperties.Name="Add subtask" />
    </Grid>
  </StackPanel>
</UserControl>
