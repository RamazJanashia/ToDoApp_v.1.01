<!-- One attachment (AttachmentRow in SubtasksAndAttachments.swift): thumbnail, name, detail line and a hover ×. -->
<UserControl
    x:Class="TodoApp.AttachmentRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
  <Grid x:Name="Root" Margin="-6,0" Padding="6" ColumnSpacing="10" Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="30" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="20" />
    </Grid.ColumnDefinitions>
    <Grid.ContextFlyout>
      <MenuFlyout x:Name="Menu">
        <MenuFlyoutItem x:Name="OpenItem" Text="Open" />
        <MenuFlyoutItem x:Name="RevealItem" Text="Show in File Explorer" />
        <MenuFlyoutItem x:Name="CopyItem" Text="Copy Link" />
        <MenuFlyoutSeparator />
        <MenuFlyoutItem x:Name="RemoveItem" Text="Remove" />
      </MenuFlyout>
    </Grid.ContextFlyout>

    <Border
        x:Name="HoverFill"
        Grid.ColumnSpan="3"
        Margin="-6,-6"
        CornerRadius="7"
        Background="{ThemeResource HoverBrush}"
        Opacity="0"
        IsHitTestVisible="False" />

    <Border
        Width="30"
        Height="30"
        CornerRadius="6"
        VerticalAlignment="Center"
        Background="{ThemeResource RaisedBrush}">
      <Grid>
        <Image x:Name="ThumbImage" Stretch="UniformToFill" />
        <FontIcon
            x:Name="LinkIcon"
            FontSize="12"
            Foreground="{ThemeResource SecondaryTextBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />
      </Grid>
    </Border>

    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
      <Grid x:Name="NameHost">
        <TextBlock
            x:Name="NameText"
            Style="{StaticResource AppTextBase}"
            FontSize="13"
            Foreground="{ThemeResource PrimaryTextBrush}"
            TextWrapping="NoWrap"
            HorizontalAlignment="Left" />
      </Grid>
      <TextBlock
          x:Name="DetailText"
          Style="{StaticResource SmallText}"
          Foreground="{ThemeResource TertiaryTextBrush}"
          MaxLines="1"
          TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <Button
        x:Name="RemoveButton"
        Grid.Column="2"
        Style="{StaticResource IconButtonStyle}"
        Width="20"
        Height="20"
        FontSize="10"
        Opacity="0"
        VerticalAlignment="Center"
        ToolTipService.ToolTip="Remove Attachment"
        AutomationProperties.Name="Remove Attachment" />
  </Grid>
</UserControl>
