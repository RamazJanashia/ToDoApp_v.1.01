<!-- Presets for the common cases plus a custom rule editor (RepeatPopover and CustomRecurrenceEditor in SchedulePopovers.swift). -->
<UserControl
    x:Class="TodoApp.RepeatFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TodoApp"
    IsTabStop="False">
  <UserControl.Resources>
    <!-- WeekdayPicker: a 25 px disc, raised with secondary ink when off, primary with background-coloured ink when on. -->
    <Style x:Key="WeekdayToggleStyle" TargetType="ToggleButton">
      <Setter Property="Width" Value="25" />
      <Setter Property="Height" Value="25" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver" />
                  <VisualState x:Name="Pressed" />
                  <VisualState x:Name="Disabled" />
                  <VisualState x:Name="Checked">
                    <VisualState.Setters>
                      <Setter Target="Disc.Fill" Value="{ThemeResource PrimaryTextBrush}" />
                      <Setter Target="Label.Foreground" Value="{ThemeResource BackgroundBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="CheckedPointerOver">
                    <VisualState.Setters>
                      <Setter Target="Disc.Fill" Value="{ThemeResource PrimaryTextBrush}" />
                      <Setter Target="Label.Foreground" Value="{ThemeResource BackgroundBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="CheckedPressed">
                    <VisualState.Setters>
                      <Setter Target="Disc.Fill" Value="{ThemeResource PrimaryTextBrush}" />
                      <Setter Target="Label.Foreground" Value="{ThemeResource BackgroundBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="CheckedDisabled">
                    <VisualState.Setters>
                      <Setter Target="Disc.Fill" Value="{ThemeResource PrimaryTextBrush}" />
                      <Setter Target="Label.Foreground" Value="{ThemeResource BackgroundBrush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Indeterminate" />
                  <VisualState x:Name="IndeterminatePointerOver" />
                  <VisualState x:Name="IndeterminatePressed" />
                  <VisualState x:Name="IndeterminateDisabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Ellipse x:Name="Disc" Fill="{ThemeResource RaisedBrush}" />
              <ContentPresenter
                  x:Name="Label"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Content="{TemplateBinding Content}"
                  FontSize="{TemplateBinding FontSize}"
                  FontWeight="{TemplateBinding FontWeight}"
                  Foreground="{ThemeResource SecondaryTextBrush}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel Width="260" Padding="6" Spacing="1">
    <local:OptionList
        x:Name="Options"
        Padding="0"
        PrimaryBrush="{ThemeResource PrimaryTextBrush}"
        SecondaryBrush="{ThemeResource SecondaryTextBrush}"
        TertiaryBrush="{ThemeResource TertiaryTextBrush}"
        HoverBrush="{ThemeResource SelectionBrush}"
        SeparatorBrush="{ThemeResource SeparatorBrush}" />

    <StackPanel x:Name="Editor" Margin="10,8,10,6" Spacing="12" Visibility="Collapsed">
      <SelectorBar x:Name="FrequencyBar">
        <SelectorBarItem x:Name="DailyItem" Text="Daily" FontSize="12" Padding="7,6,7,5" />
        <SelectorBarItem x:Name="WeeklyItem" Text="Weekly" FontSize="12" Padding="7,6,7,5" />
        <SelectorBarItem x:Name="MonthlyItem" Text="Monthly" FontSize="12" Padding="7,6,7,5" />
        <SelectorBarItem x:Name="YearlyItem" Text="Yearly" FontSize="12" Padding="7,6,7,5" />
      </SelectorBar>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock
            Style="{StaticResource AppTextBase}"
            FontSize="13"
            Foreground="{ThemeResource SecondaryTextBrush}"
            VerticalAlignment="Center"
            Text="Every" />
        <NumberBox
            x:Name="IntervalBox"
            Minimum="1"
            Maximum="99"
            SmallChange="1"
            LargeChange="1"
            SpinButtonPlacementMode="Inline"
            FontSize="13"
            VerticalAlignment="Center"
            AutomationProperties.Name="Interval" />
        <TextBlock
            x:Name="UnitText"
            Style="{StaticResource AppTextBase}"
            FontSize="13"
            VerticalAlignment="Center" />
      </StackPanel>

      <!-- Weekly rules only: the days in first-weekday order. -->
      <StackPanel x:Name="WeekdayRow" Orientation="Horizontal" Spacing="5" />

      <TextBlock
          x:Name="SummaryText"
          Style="{StaticResource SmallText}"
          Foreground="{ThemeResource TertiaryTextBrush}"
          TextWrapping="Wrap" />
    </StackPanel>
  </StackPanel>
</UserControl>
