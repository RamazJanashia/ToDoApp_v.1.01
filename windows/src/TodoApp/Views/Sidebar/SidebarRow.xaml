<UserControl
    x:Class="TodoApp.SidebarRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Microsoft.UI.Xaml.Documents"
    IsTabStop="False">
  <Grid x:Name="Chrome" Height="38" CornerRadius="8" Background="Transparent" AllowDrop="True">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="HighlightStates">
        <VisualState x:Name="Normal" />
        <VisualState x:Name="PointerOver">
          <VisualState.Setters>
            <Setter Target="Chrome.Background" Value="{ThemeResource HoverBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Selected">
          <VisualState.Setters>
            <Setter Target="Chrome.Background" Value="{ThemeResource SelectionBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="DropStates">
        <VisualState x:Name="NotTargeted" />
        <VisualState x:Name="DropTarget">
          <VisualState.Setters>
            <Setter Target="DropOutline.Opacity" Value="0.75" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid Padding="10,0" ColumnSpacing="11">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- Workspace rows use primary ink at 0.82; project rows use their colour (TintGlyph). -->
      <FontIcon x:Name="IconGlyph" FontSize="14" Opacity="0.82" Foreground="{ThemeResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <FontIcon x:Name="TintGlyph" FontSize="14" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <TextBlock
          x:Name="TitleText"
          Grid.Column="1"
          Style="{StaticResource BodyText}"
          VerticalAlignment="Center"
          MaxLines="1"
          TextTrimming="CharacterEllipsis" />
      <TextBlock
          x:Name="CountText"
          Grid.Column="2"
          Style="{StaticResource AppTextBase}"
          Foreground="{ThemeResource SecondaryTextBrush}"
          FontSize="13"
          VerticalAlignment="Center"
          docs:Typography.NumeralAlignment="Tabular" />
    </Grid>

    <Border
        x:Name="DropOutline"
        CornerRadius="8"
        BorderThickness="1.5"
        BorderBrush="{ThemeResource BlueBrush}"
        Opacity="0"
        IsHitTestVisible="False" />
  </Grid>
</UserControl>
