<!-- One day of the month grid (CalendarDayCell in CalendarMonthView.swift). -->
<UserControl
    x:Class="TodoApp.CalendarDayCell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Microsoft.UI.Xaml.Documents"
    IsTabStop="False">
  <Grid x:Name="Root" Background="Transparent" AllowDrop="True">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="DayStates">
        <VisualState x:Name="DayInMonth">
          <VisualState.Setters>
            <Setter Target="NumberText.Foreground" Value="{ThemeResource PrimaryTextBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="DayOutside">
          <VisualState.Setters>
            <Setter Target="NumberText.Foreground" Value="{ThemeResource TertiaryTextBrush}" />
          </VisualState.Setters>
        </VisualState>
        <!-- Today: a filled primary circle with the number in the background colour. -->
        <VisualState x:Name="DayToday">
          <VisualState.Setters>
            <Setter Target="DayCircle.Background" Value="{ThemeResource PrimaryTextBrush}" />
            <Setter Target="NumberText.Foreground" Value="{ThemeResource BackgroundBrush}" />
            <Setter Target="NumberText.FontWeight" Value="SemiBold" />
            <Setter Target="NumberText.Opacity" Value="1" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border x:Name="HoverFill" Background="{ThemeResource HoverBrush}" Opacity="0" IsHitTestVisible="False" />
    <Border x:Name="SelectedFill" Background="{ThemeResource SelectionBrush}" Opacity="0" IsHitTestVisible="False" />
    <Border x:Name="DropFill" Background="{ThemeResource BlueBrush}" Opacity="0" IsHitTestVisible="False" />

    <StackPanel Padding="6" Spacing="3">
      <Border
          x:Name="DayCircle"
          MinWidth="22"
          MinHeight="22"
          CornerRadius="11"
          HorizontalAlignment="Left"
          Margin="0,0,0,2"
          Background="Transparent">
        <TextBlock
            x:Name="NumberText"
            Style="{StaticResource AppTextBase}"
            FontSize="12"
            Opacity="0.85"
            docs:Typography.NumeralAlignment="Tabular"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
      </Border>
      <StackPanel x:Name="Chips" Spacing="3" />
      <TextBlock
          x:Name="MoreText"
          Style="{StaticResource AppTextBase}"
          FontSize="10.5"
          Foreground="{ThemeResource TertiaryTextBrush}"
          Margin="5,0,0,0"
          MaxLines="1"
          Visibility="Collapsed" />
      <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="3" Margin="4,0,0,0" Visibility="Collapsed" />
    </StackPanel>

    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource SeparatorBrush}" IsHitTestVisible="False" />
    <Rectangle x:Name="RightLine" Width="1" HorizontalAlignment="Right" Fill="{ThemeResource SeparatorBrush}" IsHitTestVisible="False" />
  </Grid>
</UserControl>
